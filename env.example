# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# Lấy hai giá trị Supabase ở: Project Settings > API (hoặc API Keys) trong Supabase Dashboard.

# URL của project Supabase, ví dụ: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (trước đây gọi là anon key). Không dùng service_role key ở đây.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ cần khi chạy kiểm thử E2E (Playwright): tài khoản test đã đăng ký sẵn trong Supabase Auth.
BOT_TEST_EMAIL=
BOT_TEST_PASSWORD=
